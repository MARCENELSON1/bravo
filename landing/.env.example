# URL base de la app Wellnod (donde viven las rutas /login y /onboarding).
# Los botones "Iniciar sesión" y "Empezá gratis" de la landing apuntan acá.
# En desarrollo la app corre en el 5173; en producción, poné tu dominio.
VITE_APP_URL=http://localhost:5173

# URL base de la API de Wellnod. La landing le postea el formulario de contacto
# a POST {VITE_API_URL}/leads; el backend es quien habla con el CRM (la landing
# es pública y no puede llevar la credencial del CRM adentro).
VITE_API_URL=http://localhost:8000/api/v1
